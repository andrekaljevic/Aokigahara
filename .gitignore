# Dependencies / build output
node_modules/
dist/
build/
.cache/
.parcel-cache/
# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
# Local scratch used by construction scripts (generate_trees_v2.py writes work/tex)
work/
tmp/
temp/
*.tmp
# Logs and local server output
*.log
http.log
# Environment / credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
# OS / editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# Headless browser profiles and audit scratch
.playwright/
playwright-report/
test-results/

# ---------------------------------------------------------------- Unreal Engine
# Generated, machine-local or gigabyte-scale. The .uproject, Config/, Content/,
# Source/, Plugins/ and Docs/ under unreal/ ARE tracked.
unreal/**/Binaries/
unreal/**/Build/
unreal/**/DerivedDataCache/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/.vs/
unreal/**/*.xcworkspace/
unreal/**/*.xcodeproj/
unreal/**/*.sln
*.VC.db
*.opensdf
*.sdf
*.suo
# Derived Unreal import data - regenerate with Scripts/export_*.py rather than committing.
# The JSON sidecars ARE tracked: they are small and carry the exact Landscape transform.
unreal/AokigaharaUE/Content/Aokigahara/Data/*.bin
unreal/AokigaharaUE/Content/Aokigahara/Data/*.csv
unreal/AokigaharaUE/Content/Aokigahara/Terrain/*.png
